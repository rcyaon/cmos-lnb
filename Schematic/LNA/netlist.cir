.PARAM sw_stat_mismatch = 0
.PARAM fnoicor = 1






XSUB1 _net0 _net1 _net2 _net3 _net4 LNAMkII
VP1 _net5 0 dc 0 ac 0.632456 SIN(0 0.632456 1MEG) portnum 1 z0 50
V3 _net1 0 DC 1.2
C3 _net5 _net0  10P 
I1 _net2 _net4 DC 20U
VP2 _net6 0 dc 0 ac 0.632456 SIN(0 0.632456 1MEG) portnum 2 z0 50
C4 _net6 _net3  10P 
V4 _net2 0 DC 3.3

.control

SP LIN 200 1MEG 5G 1
let delta = (s_1_1 * s_2_2) - (s_1_2 * s_2_1)
let rollett = (1 - (abs(s_1_1) ^ 2) - (abs(s_2_2) ^ 2) + (abs(delta) ^ 2))  / max((2 * abs(s_1_2 * s_2_1)), 0.000000001)
let mu = (1 - (abs(s_1_1) ^ 2))  / ( abs((s_2_2 - (delta * conj(s_1_1)))) + abs(s_1_2 * s_2_1) )
let s11_db = dB(s_1_1)
let s21_db = dB(s_2_1)
let s12_db = dB(s_1_2)
let s22_db = dB(s_2_2)
let nf_db = 10 * log( cy_2_2 / ( boltz * 10 * (z_2_1 ^ 2) ))
write spice4qucs.sp1.plot S_1_1 Y_1_1 Z_1_1 Cy_1_1 S_1_2 Y_1_2 Z_1_2 Cy_1_2 S_2_1 Y_2_1 Z_2_1 Cy_2_1 S_2_2 Y_2_2 Z_2_2 Cy_2_2 Rn NF SOpt NFmin delta rollett mu s11_db s21_db s12_db s22_db nf_db
destroy all
reset

exit
.endc
.END
