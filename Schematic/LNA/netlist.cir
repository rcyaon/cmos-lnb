.SUBCKT LNAMkII _net6 _net7 _net2 _net3 
XC4 _net0  0 cap_mim_2f0fF c_width=22u c_length=22u
I1 _net1 0 DC 10U
XSUB8 _net2 _net3 _net4 _net2 OutputBufferMkVI
XC7 _net5  0 cap_mim_2f0fF c_width=40u c_length=40u
XSUB6 _net2 _net5 _net8 _net9 _net0 _net1 GainStageMkII
XSUB14 _net2 _net5 _net9 _net4 _net0 _net1 GainStageMkII
X1 _net2  _net1  _net1  _net2 pfet_03v3 L=0.5u W=0.3u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)' ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
XSUB15 _net2 _net6 _net5 _net5 _net1 _net8 InputBufferMkI
XSUB16 _net5 _net0 _net2 _net7 _net10 ReferenceMkI
I2 _net2 _net10 DC 10U
.ENDS
.PARAM sw_stat_global = 0
.PARAM sw_stat_mismatch = 0
.PARAM fnoicor = 1
.PARAM p_val = -60





V2 _net0 0 DC 1.2
C1 input _net1  10P 
C2 _net2 output  10P 
R2 0 input  100K tc1=0.0 tc2=0.0 
V1 _net3 0 DC 3.3
XSUB1 _net1 _net0 _net3 _net2 LNAMkII

R1 output 0  50 tc1=0.0 tc2=0.0 
VP1 input 0 dc 0 ac '2*sqrt(2)*sqrt(50/1000)*pow(10,({p_val})/20)' SIN(0 '2*sqrt(2)*sqrt(50/1000)*pow(10,({p_val})/20)' 1.7G 0 0) portnum 1 z0 50

.control

tran 5e-11 1e-06 0
set specwindow=hanning
linearize v(input) v(output) 
fft v(input) v(output) 
let max_out = vecmax(mag(v(output)))
let max_in = vecmax(mag(v(input)))
let gain = max_out/max_in
write spice4qucs.fft1.plot v(input) v(output) max_out max_in gain
destroy all
reset

let start_p = -60
let stop_p = 30
let step_p = 10
let p_cur = start_p

let gain_array = vector(7)

let idx = 0

set appendwrite

while p_cur <= stop_p
  
  alterparam P_val = $&p_cur
  reset
  
  ac lin 10 100M 2G

  *write gain_array.raw gain_mag(v(output)[0]) / mag(v(input)[0])

  let gain = v(output)[1] / v(input)[1]

  write compression.raw v(output)[1] v(input)[1] gain
  
  let p_cur = p_cur + step_p
  let idx = idx + 1
end

unset appendwrite


let gain = ac.v(output)[1] / ac.v(input)[1]
write spice4qucs.custom1.plot gain
destroy all
reset

exit
.endc
.END
