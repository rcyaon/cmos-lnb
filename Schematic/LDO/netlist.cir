XC2 _net6  _net5 cap_mim_2f0fF c_width=11u c_length=22u
XC3 _net4  _net3 cap_mim_2f0fF c_width=11u c_length=22u
XR5 _net5  _net6  0 ppolyf_u_1k r_width=1u r_length=10u
XR7 0  _net5  0 ppolyf_u_1k r_width=1u r_length=24u
XR8 _net3  _net4  0 ppolyf_u_1k r_width=1u r_length=15u
XR6 0  _net3  0 ppolyf_u_1k r_width=1u r_length=14u
.ENDS
.PARAM sw_stat_global = 1
.PARAM sw_stat_mismatch = 1





XSUB1 Out1V7 Out2V5 _net0 _net1 _net2 ReferenceMkI
I1 _net0 _net2 DC 10U
V1 _net0 0 DC 3.3
V2 _net1 0 DC 1.2


.control

op
print v(Out1V7) v(Out2V5)   > spice4qucs.dc1.ngspice.dc.print
destroy all
reset

let gain_array = vector(7)

let idx = 0

set appendwrite

while idx <= 100
  
  reset
  
  dc
  let out_1v7 = v(out1v7)
  let out_2v5 = v(out2v5)
  write mc_out.raw out_1v7 out_2v5
  reset
  
  let idx = idx + 1
end

unset appendwrite


destroy all
reset

exit
.endc
.END
